# Prompt Guard - Variables de Entorno
# Copia este archivo a .env y configura tus valores

# API Keys para Capa 3 (LLM-Judge)
MISTRAL_API_KEY=tu_clave_mistral_aqui
GROQ_API_KEY=tu_clave_groq_aqui

# Autenticacion JWT
JWT_SECRET_KEY=tu_clave_secreta_jwt_aqui
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Base de Datos
DATABASE_URL=sqlite:///./data/database/attacks.db

# Servidor
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Rutas de Modelos
DISTILBERT_MODEL_PATH=./models/distilbert
DEBERTA_MODEL_PATH=./models/deberta_detector
TFIDF_MODEL_PATH=./data/models/tfidf/model.joblib

# Umbrales
HEURISTIC_THRESHOLD=0.3
LLM_THRESHOLD=5.0
VOTING_THRESHOLD=2

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Frontend
FRONTEND_PORT=3000
